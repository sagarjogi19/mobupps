# Copy to .env and adjust. Real environment variables take precedence.

# Secret used to sign JWTs. MUST be changed for anything non-local.
JWT_SECRET=dev-only-change-me-in-production

# Access token lifetime in seconds (default 1 hour).
JWT_TTL=3600

# Path to the SQLite database file (created automatically).
# DB_PATH=D:/mobupps/product-store/backend/database/app.sqlite

# CORS origin allowed to call the API ("*" for development).
CORS_ALLOW_ORIGIN=*
